  "item": [
    {
      "name": "01 - Registration",
      "item": [
        {
          "name": "01. Register Buyer (Success 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Token is returned and valid format', function () {",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "    pm.expect(jsonData.tokenType).to.eql('Bearer');",
                  "    pm.expect(jsonData.username).to.eql('alice_buyer');",
                  "    pm.expect(jsonData.role).to.eql('BUYER');",
                  "    pm.collectionVariables.set('jwtToken', jsonData.token);",
                  "    if (jsonData.userId) {",
                  "        pm.collectionVariables.set('userId', jsonData.userId);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alice_buyer\",\n  \"email\": \"alice.buyer@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"role\": \"BUYER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
