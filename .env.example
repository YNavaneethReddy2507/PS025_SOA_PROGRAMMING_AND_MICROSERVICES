# ==============================================================================
# PS025: Real-Time Distributed Bidding & Auction Engine Environment Variables
# ==============================================================================

# Database Root Password
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PORT=3306

# Dedicated Service Database Users & Passwords (Least Privilege Schema Ownership)
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_pass

AUCTION_DB_USER=auction_user
AUCTION_DB_PASSWORD=auction_pass

BIDDING_DB_USER=bidding_user
BIDDING_DB_PASSWORD=bidding_pass

PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=payment_pass

# Service Ports
EUREKA_PORT=8761
GATEWAY_PORT=8080
AUTH_PORT=8081
AUCTION_PORT=8082
BIDDING_PORT=8083
PAYMENT_PORT=8084

# Service Discovery & Inter-Service Networking
EUREKA_URI=http://eureka-server:8761/eureka/

# Security: Cryptographic HMAC-SHA256 Secret & Token Expiration
# In production, replace with a strong 256-bit cryptographically random secret
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Platform Business Configuration
PLATFORM_FEE_PERCENTAGE=0.05
